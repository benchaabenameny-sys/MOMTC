# CQ27 (module F)
# Which organizational role is associated with a given human factor or targeted asset?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?subject ?role WHERE {
  { ?subject attack:has_organizational_role ?role }
  UNION
  { ?subject attack:has_assigned_role ?role }
}
