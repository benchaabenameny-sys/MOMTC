# CQ15 (module C)
# Which vulnerabilities are known to be actively exploited?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?cveid WHERE {
  ?cve attack:has_cve_identifier ?cveid ;
       attack:has_risk_assessment ?ra .
  ?ra attack:is_known_exploited "true"^^xsd:boolean .
}
