# CQ13 (module C)
# Which indicators of compromise are generated by a given vulnerability or technique?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?source ?ioc ?pattern WHERE {
  ?source attack:generates_indicator ?ioc .
  OPTIONAL { ?ioc attack:has_indicator_pattern ?pattern . }
}
