# CQ19 (module D)
# What is the criticality level and weighted score of a given targeted asset?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?asset ?level ?weight WHERE {
  ?asset rdf:type attack:Targeted_Asset ;
         attack:has_asset_criticality ?level .
  OPTIONAL { ?level attack:has_criticality_weight ?weight . }
}
