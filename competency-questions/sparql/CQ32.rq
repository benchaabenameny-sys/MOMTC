# CQ32 (cross-module)
# Which countermeasures remediate a given vulnerability, and which techniques do they in turn mitigate?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?cm ?technique WHERE {
  attack:CVE_2023_20269 attack:is_remediated_by ?cm .
  OPTIONAL { ?cm attack:mitigates ?technique . }
}
