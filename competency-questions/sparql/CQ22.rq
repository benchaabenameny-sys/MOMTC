# CQ22 (module E)
# Which detection mechanisms are employed by a given countermeasure, and which indicators do they detect?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?cm ?mechanism ?ioc WHERE {
  ?cm attack:employs_detection_mechanism ?mechanism .
  OPTIONAL { ?mechanism attack:detects ?ioc . }
}
