# CQ35 (cross-module)
# Which technique was responsible for a specific execution that resulted in a given impact?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?technique ?impact WHERE {
  ?execution attack:results_in ?impact ;
             attack:executes_technique ?technique .
}
