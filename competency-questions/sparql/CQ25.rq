# CQ25 (module E)
# Which digital artifacts are shared between an offensive technique and its mitigating countermeasure?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?technique ?cm ?artifact WHERE {
  ?technique attack:tech_relates_to_artifact ?artifact .
  ?cm        attack:cm_relates_to_artifact   ?artifact .
}
