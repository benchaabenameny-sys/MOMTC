# CQ1 (module A) -- query for MOMTC v2.0.0 (uses has_sophistication_rank, added after the LLM-assisted evaluation)
# Which threat actors have a sophistication level of "Advanced" or higher?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?actor ?level ?rank WHERE {
  ?actor rdf:type attack:Threat_Actor_Profiling ;
         attack:has_sophistication_level ?level .
  ?level attack:has_sophistication_rank ?rank .
  attack:Advanced attack:has_sophistication_rank ?threshold .
  FILTER (?rank >= ?threshold)
}
