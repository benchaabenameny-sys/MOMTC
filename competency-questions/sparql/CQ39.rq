# CQ39 (cross-module)
# Which countermeasures defend a given targeted asset, in addition to mitigating the techniques that threaten it?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?cm ?technique WHERE {
  ?cm attack:defends_asset attack:VPN_Gateway_Asset .
  OPTIONAL { ?cm attack:mitigates ?technique . }
}
