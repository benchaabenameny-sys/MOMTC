# CQ37 (cross-module)
# Which detection mechanisms can identify indicators of compromise generated by a given vulnerability?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?ioc ?mechanism WHERE {
  attack:CVE_2020_3259 attack:generates_indicator ?ioc .
  ?mechanism attack:detects ?ioc .
}
