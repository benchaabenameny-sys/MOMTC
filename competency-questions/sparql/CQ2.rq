# CQ2 (module A)
# Which campaigns has a given threat actor orchestrated, and over what time period?

PREFIX attack: <https://attack.mitre.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?campaign ?start ?end WHERE {
  attack:Akira attack:orchestrates ?campaign .
  OPTIONAL { ?campaign attack:has_temporal_execution ?w .
             ?w attack:has_start_time ?start ; attack:has_end_time ?end . }
}
